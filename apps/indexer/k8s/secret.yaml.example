# Placeholder only — never commit a real filled-in copy of this file (matches the
# same "committed placeholder, real file kept out of version control" convention as
# ../.env.example). Recommended: don't even keep a real secret.yaml on disk — create
# the Secret imperatively instead, which never leaves the values in a file at all:
#
#   kubectl create secret generic shiyld-indexer-secrets \
#     --from-literal=DATABASE_URL='postgresql://user:pass@your-external-postgres:5432/shiyld' \
#     --from-literal=REDIS_URL='redis://redis:6379' \
#     --from-literal=INDEXER_API_KEYS=''
#
# If you do prefer a declarative file, copy this to `secret.yaml` (gitignored),
# fill in real values, and `kubectl apply -f secret.yaml`.
#
# NOT build/deploy-tested yet — see configmap.yaml's own note.
apiVersion: v1
kind: Secret
metadata:
  name: shiyld-indexer-secrets
type: Opaque
stringData:
  # Required — no managed/bundled Postgres ships with these manifests (see
  # README.md for why). Point this at your own Postgres instance.
  DATABASE_URL: "postgresql://user:password@your-postgres-host:5432/shiyld"
  # Optional — leave empty (or omit the key entirely) for in-memory/single-instance
  # mode. redis.yaml.example bundles a real Redis Deployment+Service if you want one
  # in-cluster instead of pointing at an external Redis; if you apply it, this
  # should read "redis://shiyld-indexer-redis:6379" (its Service name).
  REDIS_URL: ""
  # Optional, comma-separated — only checked when configmap.yaml's
  # INDEXER_ACCESS_MODE is "restricted". Generate real random values.
  INDEXER_API_KEYS: ""
  # Optional per-network RPC overrides — leave blank to use @shiyld/shared's free
  # public RPC default for that network. Only uncomment/fill the ones you need.
  # RPC_URL_BASE_SEPOLIA: ""
  # RPC_URL_BASE: ""
  # RPC_URL_ARBITRUM_SEPOLIA: ""
  # RPC_URL_ARBITRUM: ""
  # RPC_URL_ETHEREUM_SEPOLIA: ""
  # RPC_URL_ETHEREUM: ""
