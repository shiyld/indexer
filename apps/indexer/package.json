{
  "name": "@shiyld/indexer",
  "version": "1.0.6",
  "private": true,
  "description": "Standalone, self-hostable Shiyld indexer server — see packages/indexer-core for the embeddable library.",
  "scripts": {
    "start": "node dist/index.js",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/index.ts",
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@shiyld/shared": "^1.0.5",
    "@shiyld/indexer-core": "workspace:*",
    "pg": "^8.11.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.0.0"
  }
}
