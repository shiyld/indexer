# Shiyld Indexer — environment reference. Everything here is optional: the indexer
# runs with sane, working defaults (free public RPC, Base Sepolia, no Redis, no auth)
# with zero configuration at all. Copy this file to `.env` next to docker-compose.yml
# only if you want to change something — Compose reads `.env` automatically for the
# `${VAR:-default}` substitutions in docker-compose.yml.

# --- Database ----------------------------------------------------------------------
# Only the password matters here if you're using the bundled `postgres` service —
# docker-compose.yml already builds the full DATABASE_URL from it. Only set
# DATABASE_URL yourself if you're pointing at a Postgres instance you run separately
# (the bundled `postgres` service's own connection string is ignored in that case).
POSTGRES_PASSWORD=shiyld
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Which chain(s) to index ---------------------------------------------------------
# Comma-separated network slugs from @shiyld/shared's NETWORKS registry:
#   base-sepolia, base, arbitrum-sepolia, arbitrum, ethereum-sepolia, ethereum
# Each one indexes with that registry's free public RPC endpoint by default — no
# signup needed to get started. A single instance can watch multiple networks at
# once (each gets its own independent listener loop internally).
INDEXER_NETWORKS=base-sepolia

# Per-network RPC override — only needed if the free public default is too slow/
# rate-limited for your traffic, or you want a dedicated provider (Infura, Alchemy,
# etc.). Uncomment and fill in only the ones you're actually overriding; any left
# blank/unset fall through to the free default for that network.
# RPC_URL_BASE_SEPOLIA=
# RPC_URL_BASE=
# RPC_URL_ARBITRUM_SEPOLIA=
# RPC_URL_ARBITRUM=
# RPC_URL_ETHEREUM_SEPOLIA=
# RPC_URL_ETHEREUM=

# --- HTTP server ---------------------------------------------------------------------
INDEXER_HTTP_PORT=4001

# --- Access control & abuse prevention ------------------------------------------------
# "public" (default) — every read endpoint (health, pools, events, merkle-proof) is
#   open to anyone, no API key required. Fine for a personal/low-traffic instance.
# "restricted" — every request must carry one of INDEXER_API_KEYS. Switch to this if
#   you're exposing this instance publicly and want to control who can use it.
INDEXER_ACCESS_MODE=public
# Comma-separated list of accepted keys — only checked when INDEXER_ACCESS_MODE is
# "restricted". Generate real random values, don't reuse this example's format.
INDEXER_API_KEYS=

# Per-IP (and per-API-key, in restricted mode) request cap, regardless of access mode.
INDEXER_RATE_LIMIT_PER_MINUTE=300

# --- Cache / Socket.IO adapter --------------------------------------------------------
# docker-compose.yml bundles a `redis` service and points REDIS_URL at it by default —
# no external Redis needed. Override this to point at a Redis instance you run
# elsewhere instead, or set it to empty to run in fully in-memory (single-instance)
# mode without editing docker-compose.yml itself (the bundled `redis` container still
# starts either way in that case — harmless, just unused).
# REDIS_URL=redis://host:6379
