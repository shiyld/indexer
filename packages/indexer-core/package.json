{
  "name": "@shiyld/indexer-core",
  "version": "1.0.4",
  "description": "Shared indexer logic for the Shiyld privacy protocol — multi-network event ingestion, Merkle proof serving, and a versioned read API. Used by apps/indexer and embeddable directly into a third-party service.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiyld/indexer.git",
    "directory": "packages/indexer-core"
  },
  "homepage": "https://github.com/shiyld/indexer#readme",
  "bugs": {
    "url": "https://github.com/shiyld/indexer/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && pnpm run copy-migrations",
    "copy-migrations": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "dev": "tsc --watch",
    "test": "jest --runInBand",
    "verify:listener-live": "tsx scripts/verify-listener-live.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@shiyld/shared": "^1.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "circomlibjs": "^0.1.7",
    "cors": "^2.8.5",
    "ethers": "^6.0.0",
    "express": "^4.18.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "lru-cache": "^10.0.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "socket.io": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "jest": "^29.0.0",
    "socket.io-client": "^4.6.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.0.0"
  }
}
